# ============================================================
# config.env — 브랜치별 학습 설정 (bash `KEY=value`, 등호 양옆 공백 없음)
#
#   · 모델 브랜치(gpu/* · kaggle/*)마다 이 파일이 추적된다. common 브랜치에는 이 예시만 있다.
#   · 내 PC 전용 값(경로·토큰·실험용 모델)은 config.local.env 에 쓴다 (gitignore) — 나중에 읽혀서 덮어쓴다.
#   · src/ 안에는 모델 이름이 없다. 모델을 바꾸려면 MODEL_ID 한 줄.
# ============================================================

TARGET=local                     # gpu-server | kaggle | local
MODEL_ID=                        # HF 모델 id (예: 조직/모델). 비우면 train.sh 가 멈춘다
RUN_NAME=run1                    # outputs/<RUN_NAME>/

# ── 메모리 ──────────────────────────────────────────────────
LOAD_4BIT=1                      # 1=QLoRA(nf4)  0=bf16/fp16 LoRA
COMPUTE_DTYPE=bf16               # bf16(A100·4060) | fp16(캐글 T4·P100 — bf16 없음). CPU 면 train.py 가 fp32 로 바꾼다
MAX_SEQ=2560                     # ⚠️ system+도구 11개 정의만 ≈1,950 토큰 → 2304 아래로 내리면 정답이 잘려 train.py 가 행을 버린다. OOM 은 BATCH·LORA_R 로
BATCH=1
GRAD_ACCUM=8
LORA_R=16                        # alpha = 2r, dropout 0.05

# ── 학습 ────────────────────────────────────────────────────
EPOCHS=3
LR=2e-4
SAVE_STEPS=200                   # 캐글은 50 (세션 12h)
SEED=42
N_ROWS=1500                      # prepare_f9.py 가 만들 합성 데이터 수 (train+eval)

# ── 경로 ────────────────────────────────────────────────────
DATA_DIR=data/f9
OUTPUT_DIR=outputs/${RUN_NAME}
HF_PUSH_REPO=                    # 비우면 push 안 함. 예: your-hf-id/univus-f9-lora (private 로 만든다)

# ── 서버 전용 (gpu/*) — 서버-작업환경-설정.md 1장: 홈 10GB 영속, ~/.venv overlay 소멸 ──
PERSIST_DIR=${HOME}/univus-train-out       # 영속: data · outputs · logs
SCRATCH_DIR=${HOME}/.venv/univus-train     # 소멸: .venv · hf_cache (pod 재시작 후 setup.sh 재실행)
