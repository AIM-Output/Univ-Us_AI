# scripts/server.env — 내 PC 에서 pod 로 붙을 때 쓰는 값. 복사해서 채운다 (server.env 는 gitignore).
#   copy scripts\server.env.example scripts\server.env
SSH_HOST=168.131.30.102
SSH_PORT=30562
SSH_USER=jovyan
SSH_KEY=..\private.pem            # 저장소 루트 기준 상대경로 또는 절대경로
REMOTE_DIR=~/univus-train         # pod 에 코드가 놓이는 곳 (git archive 로 보낸다)
UNIVUS_API_KEY=change-me          # 두 Flask 서버가 같이 쓰는 Bearer 키 — pod 의 config.local.env 에도 같은 값
LOCAL_PORT=8601                   # 내 PC local_server (pod 에서는 ssh -R 로 127.0.0.1:8601)
SERVER_PORT=8600                  # pod gpu_server (내 PC 에서는 ssh -L 로 127.0.0.1:8600)
