# gpu/donut-ocr — 학교 GPU 서버(A100 MIG 1g.10gb · 9.5GiB · bf16) 에서 Donut 한국어 OCR 전체 미세조정
# 읽는 순서: config.env → config.local.env(있으면) → 셸 env (train_ocr.sh · eval_ocr.sh · src/ocr_common.load_cfg 모두 같은 규칙)
TARGET=gpu-server
MODEL_ID=naver-clova-ix/donut-base
DATASET_ID=naver-clova-ix/synthdog-ko

# ── 경로 — 체크포인트는 overlay(용량 큼, 재시작 시 사라짐), 최종 모델·평가는 홈(영속, 2.5GB 여유)
OCR_DATA_DIR=/home/jovyan_venv/.venv/univus-train/ocr_data/synthdog-ko/data
OCR_CKPT_DIR=/home/jovyan_venv/.venv/univus-train/ocr_ckpt
OCR_OUT_DIR=/home/jovyan/univus-train-out/outputs/donut-ocr-ko
HF_HUB_CACHE=/home/jovyan_venv/.venv/univus-train/hf_cache
# datasets 의 parquet→Arrow 캐시 — 기본값(~/.cache)이면 홈 2.5GB 를 채운다
HF_DATASETS_CACHE=/home/jovyan_venv/.venv/univus-train/datasets_cache
HF_HUB_OFFLINE=1

# ── 해상도·길이 — donut-base 원본 2560x1920 을 절반으로. 토큰 max 697(train)/513(val) 이라 768 은 아무것도 자르지 않는다
IMAGE_H=1280
IMAGE_W=960
MAX_LEN=768

# ── 학습 — OOM 이면 BATCH=1 GRAD_ACCUM=16 (유효 배치 16 유지)
BATCH=2
GRAD_ACCUM=8
LR=3e-5
WARMUP_STEPS=50
MAX_TRAIN_ROWS=23532   # 2026-11-13 실제 실행값 — 받아 둔 parquet 4개 전체 (1 epoch = 1,471 step ≈ 3h37m)
MAX_STEPS=-1
TIME_BUDGET_MIN=420
SAVE_STEPS=100
EVAL_ROWS=500
