# gpu/qwen3-4b — 학교 GPU 서버(A100 MIG 1g.10gb · 9.5GiB · bf16) 에서 QLoRA
TARGET=gpu-server
MODEL_ID=Qwen/Qwen3-4B
RUN_NAME=qwen3-4b-f9

# ── 메모리: 4B 4-bit 가중치 ~2.5GB + 활성화(2560 토큰, GC 켬)·오버헤드 3~5GB → 9.5GiB 안. OOM 이면 LORA_R → GRAD_ACCUM 유지한 채 BATCH 1 확인
#    MAX_SEQ 는 2304 아래로 내리지 않는다 — system+도구 정의만 ≈1,950 토큰이라 정답이 잘린다 (train.py 가 그런 행을 버린다)
LOAD_4BIT=1
COMPUTE_DTYPE=bf16
MAX_SEQ=2560
BATCH=1
GRAD_ACCUM=8
LORA_R=16

# ── 학습
EPOCHS=3
LR=2e-4
SAVE_STEPS=200
SEED=42
N_ROWS=1500

# ── 경로 (train.sh 가 data·outputs 를 PERSIST_DIR 로 심볼릭 링크한다)
DATA_DIR=data/f9
OUTPUT_DIR=outputs/${RUN_NAME}
HF_PUSH_REPO=                      # 예: your-hf-id/univus-f9-qwen3-4b-lora (private 로 만든다). 비우면 push 안 함
HF_GATED=0

# ── 서버 영속성 (서버-작업환경-설정.md 1장) — 홈 10GB 영속 / ~/.venv overlay 는 pod 재시작 시 소멸
PERSIST_DIR=${HOME}/univus-train-out         # 남음: data · outputs(어댑터·run.json·eval.md) · logs
SCRATCH_DIR=${HOME}/.venv/univus-train       # 사라짐: .venv(~8GB) · hf_cache(가중치 ~8GB) → setup.sh 재실행
PREFETCH=1                                   # setup.sh 가 가중치를 미리 받아 둔다 (0 이면 train 때 받음)
