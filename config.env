# gpu/hyperclovax-1.5b — 학교 GPU 서버(A100 MIG 1g.10gb · 9.5GiB · bf16) 에서 bf16 LoRA (4-bit 불필요)
TARGET=gpu-server
MODEL_ID=naver-hyperclovax/HyperCLOVAX-SEED-Text-Instruct-1.5B
RUN_NAME=hcx-1.5b-f9

# ── 메모리: 1.5B bf16 가중치 ~3GB + 활성화(2560 토큰) → 9.5GiB 안에서 4-bit 없이 됨. 단 seq 2560 × batch 2 의 logits 는 너무 커서 BATCH=1
#    MAX_SEQ 는 2304 아래로 내리지 않는다 (system+도구 정의 ≈1,950 토큰). OOM 이면 LORA_R → LOAD_4BIT=1 순
LOAD_4BIT=0
COMPUTE_DTYPE=bf16
MAX_SEQ=2560
BATCH=1
GRAD_ACCUM=8
LORA_R=16

# ── 학습
EPOCHS=3
LR=2e-4
SAVE_STEPS=200
SEED=42
N_ROWS=1500

# ── 경로
DATA_DIR=data/f9
OUTPUT_DIR=outputs/${RUN_NAME}
HF_PUSH_REPO=                      # 예: your-hf-id/univus-f9-hcx-1.5b-lora
HF_GATED=1                         # ⚠️ HF 에서 약관 동의(gated=auto) + HF_TOKEN 필요 — setup.sh 가 확인한다

# ── 서버 영속성
PERSIST_DIR=${HOME}/univus-train-out
SCRATCH_DIR=${HOME}/.venv/univus-train
PREFETCH=1
