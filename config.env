# gpu/qwen3-4b-v2 — AI 팀 gpu/qwen3-4b 를 이어서 학습 (v1+v2+v3 데이터). 안내: docs/F9_학습_가이드.md
#   기본값은 내 PC(하람 데스크톱 · Windows · Git Bash) 기준이다. RunPod 에서는 config.local.env 로 덮어쓴다(가이드 부록 C).
TARGET=local
MODEL_ID=Qwen/Qwen3-4B
RUN_NAME=f9-dev

# ── 메모리: AI 팀과 같은 4-bit QLoRA. MAX_SEQ 는 2304 아래로 내리지 않는다 — system+도구 정의만 ≈1,950 토큰이라 정답이 잘린다 (train.py 가 그런 행을 버린다)
#    한 step = BATCH × GRAD_ACCUM = 8 개. 그래픽 메모리 24GB 이하는 1 × 8, A100 80GB 는 8 × 1.
LOAD_4BIT=1
COMPUTE_DTYPE=bf16
MAX_SEQ=2560
BATCH=1
GRAD_ACCUM=8
LORA_R=16

# ── 학습 (AI 팀 1차는 EPOCHS=3 · SAVE_STEPS=200 — 재현 run f9-r0 만 EPOCHS=3 으로 돌린다)
EPOCHS=1
LR=2e-4
SAVE_STEPS=100
SEED=42
N_ROWS=1500

# ── 경로
DATA_DIR=data/f9
# OUTPUT_DIR 는 적지 않는다 — train.sh/eval.sh 가 outputs/${RUN_NAME} 로 만든다 (RUN_NAME=x bash train.sh 로 바꿀 수 있게)
HF_PUSH_REPO=
HF_GATED=0

# ── 서버 전용 (TARGET=gpu-server 일 때만 쓴다 — RunPod 는 config.local.env 에서 /workspace 아래로 바꾼다)
PERSIST_DIR=${HOME}/univus-train-out
SCRATCH_DIR=${HOME}/.venv/univus-train
PREFETCH=1
