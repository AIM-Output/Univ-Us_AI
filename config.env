# kaggle/qwen3-8b — 캐글 T4×2 (16GB · bf16 없음 → fp16) 에서 QLoRA. 노트북(kaggle/univus_f9_train.ipynb)이 이 값을 읽는다
TARGET=kaggle
MODEL_ID=Qwen/Qwen3-8B
RUN_NAME=qwen3-8b-f9

# ── 메모리: 8B 4-bit 가중치 ~5GB + 활성화(2560 토큰, GC 켬)·오버헤드 → T4 16GB 한 장 안. ⚠️ COMPUTE_DTYPE 은 반드시 fp16 (T4·P100 은 bf16 미지원)
#    MAX_SEQ 는 2304 아래로 내리지 않는다 (system+도구 정의 ≈1,950 토큰). OOM 이면 LORA_R 16→8
LOAD_4BIT=1
COMPUTE_DTYPE=fp16
MAX_SEQ=2560
BATCH=1
GRAD_ACCUM=8
LORA_R=16

# ── 학습 — 세션 12시간 · 디스크 초기화 → 체크포인트 짧게, 어댑터는 반드시 HF push
EPOCHS=3
LR=2e-4
SAVE_STEPS=50
SEED=42
N_ROWS=1500

# ── 경로 (캐글 /kaggle/working 기준)
DATA_DIR=data/f9
OUTPUT_DIR=outputs/${RUN_NAME}
HF_PUSH_REPO=your-hf-id/univus-f9-qwen3-8b-lora    # ⚠️ 본인 HF id 로 바꿀 것. 비우면 세션 종료와 함께 어댑터가 사라진다
HF_DATA_REPO=your-hf-id/univus-f9-data             # data/f9/*.jsonl 을 올려 둔 private dataset repo (노트북이 받는다)
HF_GATED=0
