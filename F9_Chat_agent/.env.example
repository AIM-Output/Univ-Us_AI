# F9 대화 — LLM 설정 예시. 이 파일을 .env 로 복사해 값을 채운다(.env 는 gitignore — 키를 커밋하지 않는다).
# 찾는 순서: DATA_DIR/.env → DATA_DIR 의 부모/.env → F9_Chat_agent/.env (앞의 파일이 이긴다. 환경변수가 있으면 그것이 먼저)
#   설치본은 %LOCALAPPDATA%\kr.univus.desktop\data\F9_Chat_agent\data\.env 에 둔다.
# .env 값은 F9 안에서만 쓴다(환경변수로 내보내지 않는다) — F11·F12 등 다른 기능의 LLM 설정과 섞이지 않는다.

# pod 의 학습 모델 (내 PC 터널 8600 → pod). 모델 이름은 서버가 무시하지만 비워 두면 '설정 안 됨'으로 본다.
F9_LLM_BASE_URL=http://127.0.0.1:8600/v1
F9_LLM_API_KEY=<UNIVUS_API_KEY 와 같은 값>
F9_LLM_MODEL=univus-f9

# F9_LLM_* 가 없으면 공용 슬롯 LLM_MAIN_BASE_URL · LLM_MAIN_API_KEY · LLM_MAIN_MODEL 을 대신 받는다.

# 응답을 기다리는 최대 시간(초). 기본 60.
F9_LLM_TIMEOUT=60

# 대화를 끄려면 (설정이 있어도 '분석 서비스가 설정되지 않았습니다'로 잠근다)
# F9_LLM=off
