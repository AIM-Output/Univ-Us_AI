+function merge(xs: ChatMsg[], incoming: ChatMsg[]): ChatMsg[] {
+  const byId = new Map(incoming.map((m) => [m.id, m]));
+  const have = new Set(xs.map((x) => x.id));
+  return [...xs.map((x) => byId.get(x.id) ?? x), ...incoming.filter((m) => !have.has(m.id))];
