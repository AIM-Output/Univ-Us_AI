+function shownState(m: ChatPreview, now: number): ChatPreview["state"] {
+  if (m.state !== "pending" || !now || !m.expiresAt) return m.state;
+  const t = parseLocal(m.expiresAt).getTime();
+  return Number.isFinite(t) && t <= now ? "expired" : m.state;
